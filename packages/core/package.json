{
	"$schema": "https://json.schemastore.org/package",
	"name": "@biruni/core",
	"type": "module",
	"version": "0.0.7",
	"description": "(Al-Biruni) Core Utilities",
	"keywords": [
		"wonize",
		"biruni",
		"al-biruni"
	],
	"author": "mikoloism <mikoloism@gmail.com>",
	"license": "GPL-3.0-only",
	"homepage": "https://wonize.github.io/biruni/",
	"bugs": "https://github.com/wonize/biruni/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wonize/biruni.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"require": "./dist/cjs/mod.js",
			"import": "./dist/esm/mod.js",
			"types": "./dist/types/mod.d.ts"
		},
		"./mod": {
			"require": "./dist/cjs/mod.js",
			"import": "./dist/esm/mod.js",
			"types": "./dist/types/mod.d.ts"
		},
		"./core": {
			"require": "./dist/cjs/core.js",
			"import": "./dist/esm/core.js",
			"types": "./dist/types/core.d.ts"
		},
		"./helpers": {
			"require": "./dist/cjs/helpers/mod.js",
			"import": "./dist/esm/helpers/mod.js",
			"types": "./dist/types/helpers/mod.d.ts"
		},
		"./plugin": {
			"require": "./dist/cjs/plugin.js",
			"import": "./dist/esm/plugin.js",
			"types": "./dist/types/plugin.d.ts"
		},
		"./flow": {
			"require": "./dist/cjs/flow.js",
			"import": "./dist/esm/flow.js",
			"types": "./dist/types/flow.d.ts"
		},
		"./*": {
			"require": "./dist/cjs/*.js",
			"import": "./dist/esm/*.js",
			"types": "./dist/types/*.d.ts"
		}
	},
	"main": "dist/cjs/mod.js",
	"module": "dist/esm/mod.js",
	"browser": "dist/umd/mod.global.js",
	"types": "dist/types/mod.d.ts",
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"packageManager": "pnpm@9.2.0",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"local:dev": "vitest --clearScreen --typecheck --coverage --watch --ui",
		"local:build": "tsx ./scripts/build.ts"
	},
	"dependencies": {
		"lodash.clone": "4.5.0",
		"lodash.clonedeep": "4.5.0",
		"lodash.merge": "4.6.2",
		"lodash.mergewith": "4.6.2"
	},
	"peerDependenciesMeta": {},
	"devDependencies": {
		"@types/lodash.clone": "4.5.9",
		"@types/lodash.clonedeep": "4.5.9",
		"@types/lodash.merge": "4.6.9",
		"@types/lodash.mergewith": "4.6.9"
	}
}
