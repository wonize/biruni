{
  "name": "@biruni/monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "changeset": "changeset",
    "ci:add": "changeset add",
    "ci:version": "changeset version",
    "ci:status": "changeset status",
    "ci:publish": "nr ci:prepublish && pnpm --recursive publish",
    "ci:prepublish": "nr format && nr lint && nr test && nr build && nr ci:add && nr ci:version",
    "build": "tsx scripts/build.ts",
    "build:watch": "tsx watch scripts/build.ts",
    "vitest": "vitest --typecheck",
    "test": "vitest run",
    "test:ui": "vitest --ui --clearScreen",
    "test:watch": "vitest --watch --clearScreen",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --coverage --clearScreen --ui",
    "coverage:watch": "vitest --watch --clearScreen --coverage",
    "lint": "nr eslint .",
    "lint:fix": "nr eslint --fix .",
    "eslint": "eslint --config='eslint.config.js' --color --format='stylish'",
    "lint:report:html": "nr eslint --format='html' . --output-file=\"_ignored_/logs/eslint.$(date +'%Y-%m-%d-%H-%M-%S').htm\"",
    "lint:report:stylish": "nr eslint --no-color --format='stylish' . --output-file=\"_ignored_/logs/eslint.$(date +'%Y-%m-%d-%H-%M-%S').log\"",
    "prettier": "prettier",
    "format": "prettier . --check --config='prettier.config.mjs'",
    "format:fix": "prettier . --write --config='prettier.config.mjs'",
    "vitepress": "vitepress",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antfu/ni": "0.22.1",
    "@changesets/cli": "2.27.7",
    "@repo/configs": "workspace:*",
    "@repo/mocks": "workspace:*",
    "@types/node": "20.14.2",
    "@vitest/coverage-v8": "2.0.5",
    "@vitest/ui": "2.0.5",
    "bedo": "0.0.4",
    "biruni": "workspace:*",
    "husky": "9.1.4",
    "jsdom": "24.1.1",
    "lint-staged": "15.2.9",
    "tasuku": "2.0.1",
    "terser": "5.31.6",
    "tsup": "8.2.4",
    "tsx": "4.17.0",
    "typescript": "5.5.4",
    "vite-tsconfig-paths": "5.0.1",
    "vitepress": "1.3.2",
    "vitest": "2.0.5",
    "vitest-localstorage-mock": "0.1.2",
    "zx": "8.1.4"
  },
  "dependencies": {
    "@ionic/storage": "4.0.0",
    "ajv": "8.17.1",
    "joi": "17.13.3",
    "superstruct": "2.0.2",
    "vest": "5.4.1",
    "yup": "1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "20.14.0",
    "pnpm": "9.2.0",
    "npm": "10.8.1"
  }
}
